{
  "name": "langfuse-cli",
  "version": "1.0.0-rc.0",
  "description": "Interact with Langfuse API from the command line",
  "author": "Langfuse",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/langfuse/langfuse-cli.git"
  },
  "keywords": [
    "langfuse",
    "cli",
    "llm",
    "observability",
    "tracing",
    "prompts"
  ],
  "type": "module",
  "bin": {
    "langfuse": "bin/langfuse.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "conformance:sync": "bun conformance/src/cli.ts sync",
    "conformance:add-version": "bun conformance/src/add-version.ts",
    "conformance:run": "bun conformance/src/cli.ts run",
    "conformance:all": "bun conformance/src/all.ts",
    "goldens:update": "bun scripts/goldens.ts",
    "build": "bun scripts/build.ts",
    "release": "bun scripts/release.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@types/bun": "^1.3.14",
    "@types/semver": "^7.8.0",
    "ajv": "8.17.1",
    "ajv-formats": "^3.0.1",
    "semver": "^7.8.5",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "ajv": "8.17.1"
  },
  "engines": {
    "node": ">=20"
  }
}
